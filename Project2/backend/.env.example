# Foodie Backend Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=foodie-super-secret-development-key-change-in-production
JWT_SECRET_KEY=foodie-jwt-access-key-2026-secure-token
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# MySQL Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=foodie_db

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
